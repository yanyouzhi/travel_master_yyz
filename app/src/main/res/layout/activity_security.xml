<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CCE4EF"
    tools:context=".SecurityActivity">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:elevation="4dp"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:navigationIcon="@drawable/baseline_arrow_back_24"
            >
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="账号安全"
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@color/black" />
        </androidx.appcompat.widget.Toolbar>


        <FrameLayout
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="10dp"
            android:paddingVertical="20dp"
            android:paddingHorizontal="5dp"
            android:background="@drawable/ly1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_marginStart="10dp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="18dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="登录密码"/>

                <TextView
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="10dp"
                    android:textSize="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="建议定期更换密码"/>

            </LinearLayout>


            <LinearLayout
                android:id="@+id/ly1"
                android:layout_gravity="end|center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:textColor="@color/blue_click"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="10dp"
                    android:textSize="17dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="修改"/>

                <ImageView
                    android:layout_marginTop="2.5dp"
                    android:layout_gravity="bottom"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/baseline_keyboard_arrow_right_24"/>

            </LinearLayout>

        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/ly2"
            android:paddingHorizontal="5dp"
            android:paddingVertical="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="手机号码"
                    android:textColor="@color/black"
                    android:textSize="18dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="5dp"
                    android:text="13660308758"
                    android:textSize="15dp" />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/ly2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="5dp"
                    android:text="更换"
                    android:textColor="@color/blue_click"
                    android:textSize="17dp" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom"
                    android:layout_marginTop="2.5dp"
                    android:src="@drawable/baseline_keyboard_arrow_right_24" />

            </LinearLayout>

        </FrameLayout>

        <FrameLayout
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="3dp"
            android:paddingVertical="20dp"
            android:paddingHorizontal="5dp"
            android:background="@drawable/ly3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_marginStart="10dp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="18dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="邮箱账号"/>

                <TextView
                    android:id="@+id/tv_email"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="10dp"
                    android:textSize="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="852849843@qq.com"/>

            </LinearLayout>


            <LinearLayout
                android:id="@+id/ly3"
                android:layout_gravity="end|center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:textColor="@color/blue_click"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="10dp"
                    android:textSize="17dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="更换"/>

                <ImageView
                    android:layout_marginTop="2.5dp"
                    android:layout_gravity="bottom"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/baseline_keyboard_arrow_right_24"/>

            </LinearLayout>

        </FrameLayout>


        <!-- 安全提示 -->
        <LinearLayout
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_user_info_diary"
            android:padding="12dp"
            android:radius="8dp"
            >

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/baseline_security_24"
                android:contentDescription="安全提示图标"
                android:layout_marginEnd="8dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="安全提示"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="上次登录时间：2024 年 1 月 15 日 14:30"
                    android:textSize="14sp"
                    android:paddingTop="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="账号安全状态：正常"
                    android:textSize="14sp"
                    android:paddingTop="2dp"/>
            </LinearLayout>
        </LinearLayout>



        <!-- 安全建议 -->
        <LinearLayout
            android:textColor="@color/black"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_user_info_diary"
            android:padding="12dp"
            android:radius="8dp"
            >

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/baseline_lightbulb_24"
                android:contentDescription="安全建议图标"
                android:layout_marginEnd="8dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="安全建议"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• 定期更换登录密码，提高账号安全性"
                    android:textSize="14sp"
                    android:paddingTop="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• 开启双重认证，增加账号保护"
                    android:textSize="14sp"
                    android:paddingTop="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• 不要在不信任的设备上登录账号"
                    android:textSize="14sp"
                    android:paddingTop="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• 保持手机号和邮箱的有效性"
                    android:textSize="14sp"
                    android:paddingTop="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/out"
            android:textSize="18dp"
            android:paddingVertical="12dp"
            android:layout_marginTop="20dp"
            android:textColor="@color/white"
            android:background="@drawable/send_shape"
            android:layout_marginHorizontal="70dp"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="退出登录"/>

    </LinearLayout>


</RelativeLayout>